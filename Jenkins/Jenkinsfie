pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'Devengineer',
                url: 'https://github.com/jaswanthr349-eng/Devops.git'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                echo "Deploying files..."
                cp -r * /var/www/html/
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                curl -I http://localhost || true
                '''
            }
        }
    }
}
